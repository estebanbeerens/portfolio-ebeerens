generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id           String   @id @default(cuid())
  name         String
  headline     String?
  bio          String?
  avatarUrl    String?
  location     String?
  linkedinUrl  String?
  githubUrl    String?
  instagramUrl String?
  xUrl         String?
  youtubeUrl   String?
  updatedAt    DateTime @updatedAt
}

model Project {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  shortDescription String    @db.VarChar(255)
  description      String    @db.Text
  imageUrl         String?
  client           String?
  jobRole          String?
  liveUrl          String?
  startDate        DateTime
  endDate          DateTime?
  skills           Skill[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Skill {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
  roles    Role[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String   @unique
  logoUrl   String?
  website   String?
  roles     Role[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  SELF_EMPLOYED
  FREELANCE
  INTERNSHIP
  TRAINEE
  APPRENTICESHIP
  SEASONAL
}

model Role {
  id             String          @id @default(cuid())
  jobTitle       String
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  location       String?
  employmentType EmploymentType?
  startDate      DateTime
  endDate        DateTime?
  skills         Skill[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  githubUserId String
  displayName  String?
  avatarUrl    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id           String   @id @default(cuid())
  fullName     String
  email        String
  organization String?
  subject      String
  message      String
  createdAt    DateTime @default(now())
}

enum FeatureFlagKey {
  CONTACT
  PROJECTS
  ROLES
  SKILLS
}

model FeatureFlag {
  key       FeatureFlagKey @id
  enabled   Boolean        @default(false)
  updatedAt DateTime       @updatedAt
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
}

enum ActivityEntity {
  PROFILE
  PROJECT
  ROLE
  ORGANIZATION
  RESUME
}

model ActivityLog {
  id         String         @id @default(cuid())
  entityType ActivityEntity
  // Absent for DELETED entries — the referenced row no longer exists.
  entityId   String?
  action     ActivityAction
  summary    String
  actor      String?
  createdAt  DateTime       @default(now())

  @@index([createdAt])
}

model Resume {
  id         String           @id @default(cuid())
  fileName   String
  objectKey  String
  mimeType   String
  fileSize   Int
  uploadedAt DateTime         @default(now())
  downloads  ResumeDownload[]
}

model ResumeDownload {
  id        String   @id @default(cuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
