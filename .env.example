POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://user:password@localhost:5433/db

GITHUB_CLIENT_ID=changeme
GITHUB_CLIENT_SECRET=changeme
GITHUB_CALLBACK_URL=http://localhost:4300/api/auth/github/callback
ADMIN_GITHUB_ID=changeme
ADMIN_APP_URL=http://localhost:4300

TURNSTILE_SECRET_KEY=changeme

# Cloudflare R2. Resume upload/download returns 503 until these are set.
R2_ACCOUNT_ID=changeme
R2_ACCESS_KEY_ID=changeme
R2_SECRET_ACCESS_KEY=changeme
R2_DOCUMENTS_BUCKET=portfolio-documents
R2_IMAGES_BUCKET=portfolio-images
R2_BACKUPS_BUCKET=portfolio-backups
# Public base URL the images bucket is served from (custom domain or r2.dev URL).
R2_PUBLIC_BASE_URL=changeme
# Only set this if your buckets were created under a data-residency jurisdiction (e.g. "eu") —
# leave unset for the default (non-jurisdictional) buckets. Both buckets must share one jurisdiction;
# it can't be changed after a bucket is created.
R2_JURISDICTION=eu
